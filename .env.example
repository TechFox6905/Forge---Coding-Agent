# Copy to .env and fill in. .env is gitignored. Every variable the app reads
# from the environment is listed here with a safe placeholder; config/settings.py
# (pydantic-settings) is the single reader. Add a line here the moment a new var is introduced.


# --- Inference: Gemini (google-genai) ---
GEMINI_API_KEY=changeme
# Model id is config-driven; override the default (gemini-3.5-flash-lite) here.
# GEMINI_MODEL=gemini-3.5-flash-lite


# --- Logging ---
# LOG_LEVEL=INFO
# Logs go to a file, OFF the terminal. Default: <cwd>/.forge/logs/forge.log.
# Set FORGE_LOG_FILE="" (empty) to disable file logging entirely.
# FORGE_LOG_FILE=.forge/logs/forge.log


# --- Observability: Opik (ADR-002) ---
# Presence-based tracing: set OPIK_API_KEY and forge sends one trace per turn (REPL) / per run
# (`forge run`) to Opik — every LLM + tool call, with tokens and (for priced models like Gemini) cost.
# LEAVE IT UNSET (the default) and forge is byte-identical: init_tracing() is a silent no-op — zero
# spans, no network. So this whole block stays COMMENTED OUT: copying this file to .env must NOT switch
# tracing on with a bogus key. Get a free key at comet.com; never commit a real one.
# OPIK_API_KEY=changeme
# The Comet workspace the traces land in (the `Comet-Workspace` OTLP header). Default: default.
# OPIK_WORKSPACE=default
# The Opik project name traces are grouped under (the `projectName` OTLP header). Default: forge.
# OPIK_PROJECT_NAME=forge
# Self-hosted Opik: set the OTLP BASE url of your instance (the exporter appends /v1/traces). Unset =
# Comet cloud (https://www.comet.com/opik/api/v1/private/otel). Example self-host base:
# OPIK_URL_OVERRIDE=http://localhost:5173/api/v1/private/otel


# --- Local persistence ---
# Conversation log / durability store (SQLite). Defaults to a project-local file.
# FORGE_DB_PATH=./forge.db
# Append-only JSONL session log dir (used by `forge --resume`). Defaults to .forge/sessions
# (gitignored). Override to relocate where session logs are written.
# SESSIONS_DIR=.forge/sessions